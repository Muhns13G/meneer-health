# Environment settings grouped by integration and function; variables alphabetised within each group.
# Canonical metadata: config/environment-catalogue.ts. Local credentials must remain Git-ignored.

# Public build-time media and campaign settings
# Every VITE_* value is public. Never put secrets or patient information here.
VITE_CAMPAIGN_PRINT_PROOF=false
VITE_PEPTIDE_VIDEO_POSTER_URL=
VITE_PEPTIDE_VIDEO_URL=

# Supabase database and server credentials
# Server-only credentials. SUPABASE_DB_URL is for external recovery runners, not the Worker.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_URL=

# Identity and treatment-intent encryption
# Use distinct server-only encryption keys; never reuse keys across purposes.
IDENTITY_PREACTIVATION_KEY_BASE64=
IDENTITY_SESSION_KEY_BASE64=
JOURNEY_INTENT_ENCRYPTION_KEY_BASE64=

# Protected medical intake
# Enable only for the reviewed tenant; keep the medical keyring independently recoverable.
MEDICAL_INTAKE_KEYRING_JSON=
MEDICAL_INTAKE_MODE=disabled
MEDICAL_INTAKE_TENANT_ID=

# Provider handoff
# Configure all three together with the exact approved patient-intake destination, not a staff login URL.
HANDOFF_DESTINATION_ID=
HANDOFF_DESTINATION_VERSION=
HANDOFF_INTAKE_URL=

# Pilot measurement
# Keep disabled unless the approved pilot measurement release is in place.
MEASUREMENT_MODE=disabled

# Commerce and payment route gates
# Checkout, webhook and refund modes are separately gated; credentials alone do not activate them.
COMMERCE_CHECKOUT_MODE=disabled
COMMERCE_REFUND_MODE=disabled
COMMERCE_REVIEW_MODE=disabled
COMMERCE_REVIEW_TENANT_ID=
COMMERCE_WEBHOOK_MODE=disabled

# Private product catalogue and quote gates
# Catalogue visibility is not ordering authority. Product releases remain separately approved.
PRODUCT_CATALOGUE_MODE=disabled
PRODUCT_CATALOGUE_TENANT_ID=
PRODUCT_ORDERING_MODE=disabled
PRODUCT_ORDERING_TENANT_ID=
PRODUCT_QUOTES_MODE=disabled
PRODUCT_QUOTES_TENANT_ID=

# Stripe sandbox credentials and account
# Keep test credentials separate from live credentials; never expose either in VITE_* values.
STRIPE_CHECKOUT_ACCOUNT_ID=
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SERVICE_IDENTITY_ID=
STRIPE_WEBHOOK_SIGNING_SECRET=

# Stripe live credentials and readiness
# Requires an approved current release. Readiness confirmation is only for the guarded read-only check.
STRIPE_LIVE_ACCOUNT_ID=
STRIPE_LIVE_READINESS_CONFIRM=
STRIPE_LIVE_RESTRICTED_KEY=
STRIPE_LIVE_WEBHOOK_SIGNING_SECRET=

# Brevo API and SMTP
# The HTTPS API key and SMTP key are different credentials; neither is browser-public.
BREVO_API_KEY=

# Internal operations alerts
# Alert delivery requires approved tenant configuration and a verified delivery rehearsal.
OPERATIONS_ALERTS_MODE=disabled
OPERATIONS_ALERTS_TENANT_ID=

# Transactional notifications
# Use a dedicated webhook credential, not an API or encryption key.
TRANSACTIONAL_NOTIFICATIONS_MODE=disabled
TRANSACTIONAL_NOTIFICATIONS_TENANT_ID=
TRANSACTIONAL_NOTIFICATION_WEBHOOK_SECRET=

# Mobile invitation delivery and redemption
# SMS delivery, email conversion, redemption and callbacks are separate gates; OTP expiry is unchanged.
MOBILE_INVITATIONS_DELIVERY_READY=false
MOBILE_INVITATIONS_EMAIL_MODE=disabled
MOBILE_INVITATIONS_MODE=disabled
MOBILE_INVITATIONS_REDEMPTION_MODE=disabled
MOBILE_INVITATIONS_TENANT_ID=
MOBILE_INVITATIONS_US_DELIVERY_READY=false
MOBILE_INVITATIONS_WEBHOOK_MODE=disabled
MOBILE_INVITATION_CLAIM_KEY_BASE64=

# Telnyx messaging
# Use only the approved profile and sender. An enabled alpha sender must not be empty.
TELNYX_ALPHA_SENDER=
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_PUBLIC_KEY_BASE64=

# Encrypted recovery and heartbeat
# External recovery-runner settings are not Worker bindings. Secure encryption keys independently.
BACKUP_HEARTBEAT_URL=
RECOVERY_ENCRYPTION_KEY_BASE64=
