# Public Vite build-time values. Every VITE_* value is exposed to browsers; never place secrets in
# this namespace.
#
# No server-runtime secret is currently required. Future server-only secrets belong in ignored
# .dev.vars files locally and Cloudflare Variables and Secrets for hosted environments. Document
# names here without values only after the consuming server boundary exists.

# Optional peptide explainer media URLs, for example:
# /media/peptides/peptide-explainer-draft.mp4
VITE_PEPTIDE_VIDEO_URL=
VITE_PEPTIDE_VIDEO_POSTER_URL=

# Enables internal poster print proofs. Keep false for normal public builds.
VITE_CAMPAIGN_PRINT_PROOF=false
