# Public Vite build-time values. Canonical ownership, environment, sensitivity, and rotation
# metadata lives in config/environment-catalogue.ts. Every VITE_* value is exposed to browsers;
# never place secrets or patient information in this namespace.
#
# Server-only values belong in ignored .dev.vars files locally and Cloudflare Variables and Secrets
# for hosted environments. The pair serves server-only persistence and identity administration.
# Never prefix these values with VITE_. Preview remains provider-disabled.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Owner: Content and release owner. Optional root-relative or HTTPS peptide media URLs, for example:
# /media/peptides/peptide-explainer-draft.mp4
VITE_PEPTIDE_VIDEO_URL=
VITE_PEPTIDE_VIDEO_POSTER_URL=

# Owner: Campaign and release owner. Keep false for normal public builds and hosted production.
VITE_CAMPAIGN_PRINT_PROOF=false
