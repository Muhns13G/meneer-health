# Public Vite build-time values. Canonical ownership, environment, sensitivity, and rotation
# metadata lives in config/environment-catalogue.ts. Every VITE_* value is exposed to browsers;
# never place secrets or patient information in this namespace.
#
# Server-only values belong in ignored .dev.vars files locally and Cloudflare Variables and Secrets
# for hosted environments. The pair serves server-only persistence and identity administration.
# Never prefix these values with VITE_. Preview remains provider-disabled.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional server-only pilot measurement gate. Omit or set disabled in every normal environment.
# The exact value pilot requires the complete Supabase server pair and must not be activated until
# Keep disabled until Task 7.9 plus final privacy/security review pass. Never prefix with VITE_.
MEASUREMENT_MODE=disabled

# Optional server-only key for encrypted, short-lived treatment-intent state. Generate exactly 32
# random bytes encoded as standard base64. Without it the intent endpoint remains unavailable.
JOURNEY_INTENT_ENCRYPTION_KEY_BASE64=

# Optional local recovery pair. The hosted GitHub recovery runner additionally requires
# RECOVERY_EXPORT_SOURCE, RECOVERY_R2_BUCKET, CLOUDFLARE_ACCOUNT_ID, R2_ACCESS_KEY_ID,
# R2_SECRET_ACCESS_KEY and, for production exports, SUPABASE_DB_URL. Store those as repository
# variables/secrets—not Worker variables, VITE_* values, or committed files.
RECOVERY_ENCRYPTION_KEY_BASE64=
BACKUP_HEARTBEAT_URL=

# Optional all-or-none Stripe test-mode set. Use a least-privilege restricted key, never a live or
# browser-exposed key. Checkout remains inactive until the TD-010 commercial/legal release gate.
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
STRIPE_WEBHOOK_SERVICE_IDENTITY_ID=

# Owner: Content and release owner. Optional root-relative or HTTPS peptide media URLs, for example:
# /media/peptides/peptide-explainer-draft.mp4
VITE_PEPTIDE_VIDEO_URL=
VITE_PEPTIDE_VIDEO_POSTER_URL=

# Owner: Campaign and release owner. Keep false for normal public builds and hosted production.
VITE_CAMPAIGN_PRINT_PROOF=false
