# Public Vite build-time values. Canonical ownership, environment, sensitivity, and rotation
# metadata lives in config/environment-catalogue.ts. Every VITE_* value is exposed to browsers;
# never place secrets or patient information in this namespace.
#
# Server-only values belong in ignored .dev.vars files locally and Cloudflare Variables and Secrets
# for hosted environments. The pair serves server-only persistence and identity administration.
# Never prefix these values with VITE_. Preview remains provider-disabled.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional server-only pilot measurement gate. Omit or set disabled in every normal environment.
# The exact value pilot requires the complete Supabase server pair and must not be activated until
# Keep disabled until Task 7.9 plus final privacy/security review pass. Never prefix with VITE_.
MEASUREMENT_MODE=disabled

# Optional server-only key for encrypted, short-lived treatment-intent state. Generate exactly 32
# random bytes encoded as standard base64. Without it the intent endpoint remains unavailable.
JOURNEY_INTENT_ENCRYPTION_KEY_BASE64=

# Optional, distinct server-only AES-256-GCM key for a 10-minute invite-verification continuation.
# Without this and the Supabase server pair, POST /account/verify fails closed. Never prefix VITE_.
IDENTITY_PREACTIVATION_KEY_BASE64=
IDENTITY_SESSION_KEY_BASE64=

# Optional private portal hand-off configuration. All three values must be configured together.
# Store the exact owner-approved patient-intake URL as a Worker secret; never use a staff login URL.
# Its exact digest/version must receive AAL2 security-admin approval and match client authorisation.
# Blank configuration disables link issuance. Never prefix VITE_ or commit the real URL.
HANDOFF_INTAKE_URL=
HANDOFF_DESTINATION_ID=
HANDOFF_DESTINATION_VERSION=

# Optional local recovery pair. The hosted GitHub recovery runner additionally requires
# RECOVERY_EXPORT_SOURCE, RECOVERY_R2_BUCKET, CLOUDFLARE_ACCOUNT_ID, R2_ACCESS_KEY_ID,
# R2_SECRET_ACCESS_KEY and, for production exports, SUPABASE_DB_URL. Store those as repository
# variables/secrets—not Worker variables, VITE_* values, or committed files.
RECOVERY_ENCRYPTION_KEY_BASE64=
BACKUP_HEARTBEAT_URL=

# Optional all-or-none Stripe test-mode set. Use a least-privilege restricted key, never a live or
# browser-exposed key. Checkout remains inactive until the TD-010 commercial/legal release gate.
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
STRIPE_WEBHOOK_SERVICE_IDENTITY_ID=

# Owner: Content and release owner. Optional root-relative or HTTPS peptide media URLs, for example:
# /media/peptides/peptide-explainer-draft.mp4
VITE_PEPTIDE_VIDEO_URL=
VITE_PEPTIDE_VIDEO_POSTER_URL=

# Owner: Campaign and release owner. Keep false for normal public builds and hosted production.
VITE_CAMPAIGN_PRINT_PROOF=false
# Internal alerts remain disabled until hosted migration and synthetic delivery approval.
# Brevo HTTPS API key, NOT the SMTP key. Never prefix these settings with VITE_.
OPERATIONS_ALERTS_MODE=disabled
# Mobile invitations: server-only, no real SMS authority implied by these placeholders.
MOBILE_INVITATIONS_MODE=disabled
MOBILE_INVITATIONS_WEBHOOK_MODE=disabled
TELNYX_PUBLIC_KEY_BASE64=
MOBILE_INVITATIONS_DELIVERY_READY=false
MOBILE_INVITATIONS_TENANT_ID=
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_FROM_NUMBER=
# Generic client notifications remain disabled until the scoped delivery rehearsal.
TRANSACTIONAL_NOTIFICATIONS_MODE=disabled
TRANSACTIONAL_NOTIFICATIONS_TENANT_ID=
# Dedicated random base64url webhook credential; never reuse API/encryption credentials.
TRANSACTIONAL_NOTIFICATION_WEBHOOK_SECRET=
COMMERCE_REVIEW_MODE=disabled
COMMERCE_REVIEW_TENANT_ID=
COMMERCE_CHECKOUT_MODE=disabled
COMMERCE_WEBHOOK_MODE=disabled
COMMERCE_REFUND_MODE=disabled
STRIPE_CHECKOUT_ACCOUNT_ID=
OPERATIONS_ALERTS_TENANT_ID=
BREVO_API_KEY=
# Protected medical intake remains disabled until reviewed publication and release proof.
MEDICAL_INTAKE_MODE=disabled
MEDICAL_INTAKE_TENANT_ID=
MEDICAL_INTAKE_KEYRING_JSON=
