{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meneer-health",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "preview_urls": true,
  "vars": {
    "OPERATIONS_ALERTS_MODE": "disabled",
    "TRANSACTIONAL_NOTIFICATIONS_MODE": "disabled",
    "PRODUCT_CATALOGUE_MODE": "disabled",
    "PRODUCT_QUOTES_MODE": "disabled",
    "PRODUCT_QUOTES_TENANT_ID": "",
    "PRODUCT_CATALOGUE_TENANT_ID": "",
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "secrets": {
    "required": ["JOURNEY_INTENT_ENCRYPTION_KEY_BASE64"],
  },
  "ratelimits": [
    {
      "name": "REQUEST_RATE_LIMITER",
      "namespace_id": "51101",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "persist": true,
    },
  },
}
