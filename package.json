{
  "name": "meneer-health",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.x",
    "node": ">=22.22.0 <23"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun run check:client-bundle",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "bun run test && bun run test:e2e",
    "typecheck": "tsc --noEmit",
    "audit": "bun audit",
    "audit:prod": "bun audit --prod",
    "deploy:dry-run": "bun run build && wrangler deploy --dry-run",
    "check:client-bundle": "bun run scripts/check-client-bundle.ts",
    "check:cloudflare-types": "wrangler types --check",
    "check:generated": "git diff --exit-code -- src/routeTree.gen.ts",
    "check:discovery": "bun run scripts/check-public-discovery.ts",
    "check:portability": "bun run scripts/check-portability.ts",
    "db:start": "supabase start",
    "db:start:test": "supabase start -x realtime,storage-api,imgproxy,mailpit,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "test:auth": "bun run scripts/test-supabase-auth-integration.ts",
    "test:authz": "bun run scripts/test-supabase-authorisation-integration.ts",
    "test:commands": "bun run scripts/test-supabase-workflow-commands-integration.ts",
    "test:audit": "bun run scripts/test-supabase-audit-integration.ts",
    "test:security-evidence": "bun run scripts/test-supabase-security-evidence-integration.ts",
    "test:security:hosted": "bun run scripts/test-hosted-request-security.ts",
    "test:lifecycle": "bun run scripts/test-supabase-lifecycle-integration.ts",
    "test:payments": "bun run scripts/test-supabase-payments-integration.ts",
    "test:payments:provider": "bun run scripts/test-stripe-payments-provider-integration.ts",
    "test:fulfilment": "bun run scripts/test-supabase-fulfilment-integration.ts",
    "exercise:incident": "bun run scripts/run-controlled-incident-exercise.ts",
    "exercise:recovery": "bun run scripts/run-synthetic-recovery-exercise.ts",
    "recovery:hosted": "bun run scripts/run-hosted-recovery-export.ts",
    "db:lint": "supabase db lint --local --level error",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.2",
    "@tanstack/react-router": "1.169.2",
    "@tanstack/react-start": "1.167.65",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "22.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "^1.51.1",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.7.3",
    "supabase": "2.113.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "seroval": "^1.6.2",
    "tsx": "4.23.11",
    "vite": "7.3.6"
  }
}
